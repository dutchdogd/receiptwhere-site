---
// Served by Cloudflare Pages with status 404 for any path that does not exist.
import Base from "../layouts/Base.astro";
---
<Base title="Page not found: ReceiptWhere" description="This page does not exist." path="/404/" noindex noCanonical>
  <section class="page-hero">
    <div class="wrap stack">
      <p class="eyebrow eyebrow-amber">404</p>
      <h1>This receipt isn't in the shoebox.</h1>
    </div>
  </section>
  <section class="section section-tight">
    <div class="wrap notfound">
      <p class="lead">The page you were looking for doesn't exist, or it moved.</p>
      <ul class="notfound-links">
        <li><a href="/">Home</a></li>
        <li><a href="/features/">Features</a></li>
        <li><a href="/pricing/">Pricing</a></li>
        <li><a href="/blog/">Blog</a></li>
        <li><a href="/delete-account/">Delete your account or receipts</a></li>
      </ul>
      <p>Still stuck? Write to <a href="mailto:receipt@receiptwhere.com">receipt@receiptwhere.com</a>.</p>
    </div>
  </section>
</Base>
