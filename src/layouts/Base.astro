---
// Shared layout for the Astro-built pages. The protected pages (terms, privacy,
// delete-account) are NOT built from this: they live in public/ byte for byte.
import "../styles/site.css";
import Mark from "../components/Mark.astro";

type Page = "home" | "features" | "pricing" | "about";
interface Props { title: string; description: string; path: string; current?: Page }
const { title, description, path, current } = Astro.props;
const canonical = new URL(path, Astro.site).href;
const year = new Date().getFullYear();

// No "Sign in" until app.receiptwhere.com exists (Chat, S2).
const nav: { href: string; label: string; page?: Page }[] = [
  { href: "/#how", label: "How it works" },
  { href: "/features/", label: "Features", page: "features" },
  { href: "/pricing/", label: "Pricing", page: "pricing" },
  { href: "/about/", label: "About", page: "about" },
];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta name="theme-color" content="#12233D">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="preload" href="/fonts/dm-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/dm-sans-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/fonts/fonts.css">
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <nav class="wrap" aria-label="Main">
    <a class="brand" href="/" aria-current={current === "home" ? "page" : undefined}><Mark size={32} /><span>ReceiptWhere</span></a>
    {nav.map((item) => (
      <a href={item.href} aria-current={item.page && item.page === current ? "page" : undefined}>{item.label}</a>
    ))}
    <a class="btn btn-amber btn-small" href="/#get">Get the app</a>
  </nav>
</header>
<main id="main">
  <slot />
</main>
<footer class="site-footer">
  <div class="wrap">
    <span class="owner">© {year} DuoNex AI LLC · Burien, Washington</span>
    <a href="/terms/">Terms</a>
    <a href="/privacy/">Privacy</a>
    <a href="/delete-account/">Delete account</a>
    <a href="mailto:receipt@receiptwhere.com">receipt@receiptwhere.com</a>
  </div>
</footer>
</body>
</html>
