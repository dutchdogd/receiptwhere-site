---
// Shared layout for the Astro-built pages. The protected pages (terms, privacy,
// delete-account) are NOT built from this: they live in public/ byte for byte.
import "../styles/site.css";
import Mark from "../components/Mark.astro";
import { ldJson } from "../lib/site";

type Page = "home" | "features" | "pricing" | "about" | "blog";
interface Props {
  title: string;
  description: string;
  path: string;
  current?: Page;
  /** Site-relative path of the Open Graph image (1200x630). Defaults to the site card. */
  ogImage?: string;
  ogType?: "website" | "article";
  published?: Date;
  modified?: Date;
  tags?: string[];
  /** Draft posts on previews, the 404 page: never indexable. */
  noindex?: boolean;
  /** The 404 page has no canonical URL. */
  noCanonical?: boolean;
  /** schema.org data, emitted as a JSON-LD data block. A data block (non-JavaScript
      type) is never executed, so it is outside script-src: the CSP stays 'none'. */
  jsonLd?: unknown;
}
const { title, description, path, current, ogImage = "/og/default.png", ogType = "website",
        published, modified, tags = [], noindex = false, noCanonical = false, jsonLd } = Astro.props;
const canonical = new URL(path, Astro.site).href;
const image = new URL(ogImage, Astro.site).href;
const year = new Date().getFullYear();

// No "Sign in" until app.receiptwhere.com exists (Chat, S2).
const nav: { href: string; label: string; page?: Page }[] = [
  { href: "/#how", label: "How it works" },
  { href: "/features/", label: "Features", page: "features" },
  { href: "/pricing/", label: "Pricing", page: "pricing" },
  { href: "/about/", label: "About", page: "about" },
  { href: "/blog/", label: "Blog", page: "blog" },
];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
{!noCanonical && <link rel="canonical" href={canonical}>}
{noindex && <meta name="robots" content="noindex,nofollow">}
<meta name="theme-color" content="#12233D">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
{jsonLd !== undefined && <script is:inline type="application/ld+json" set:html={ldJson(jsonLd)} />}
<link rel="alternate" type="application/rss+xml" title="ReceiptWhere blog" href="/blog/rss.xml">
<meta property="og:site_name" content="ReceiptWhere">
<meta property="og:type" content={ogType}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={image}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:locale" content="en_US">
{published && <meta property="article:published_time" content={published.toISOString()}>}
{modified && <meta property="article:modified_time" content={modified.toISOString()}>}
{tags.map((t) => <meta property="article:tag" content={t}>)}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={image}>
<link rel="preload" href="/fonts/dm-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/dm-sans-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/fonts/fonts.css">
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <nav class="wrap" aria-label="Main">
    <a class="brand" href="/" aria-current={current === "home" ? "page" : undefined}><Mark size={32} /><span>ReceiptWhere</span></a>
    {nav.map((item) => (
      <a href={item.href} aria-current={item.page && item.page === current ? "page" : undefined}>{item.label}</a>
    ))}
    <a class="btn btn-amber btn-small" href="/#get">Get the app</a>
  </nav>
</header>
<main id="main">
  <slot />
</main>
<footer class="site-footer">
  <div class="wrap">
    <span class="owner">© {year} DuoNex AI LLC · Burien, Washington</span>
    <a href="/blog/">Blog</a>
    <a href="/terms/">Terms</a>
    <a href="/privacy/">Privacy</a>
    <a href="/delete-account/">Delete account</a>
    <a href="mailto:receipt@receiptwhere.com">receipt@receiptwhere.com</a>
  </div>
</footer>
</body>
</html>
