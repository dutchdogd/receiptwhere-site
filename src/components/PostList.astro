---
import { Picture } from "astro:assets";
import { formatDate, readingMinutes, tagSlug, type Post } from "../lib/blog";
interface Props { posts: Post[] }
const { posts } = Astro.props;
// The list thumbnail repeats the post's cover next to its linked title, so it is
// decorative here (alt=""); the post page carries the cover with its description.
---
{posts.length === 0 ? (
  <p class="lead">No posts yet.</p>
) : (
  <ol class="post-list">
    {posts.map((p) => (
      <li class="post-item">
        {p.data.cover && (
          <Picture class="post-thumb" src={p.data.cover} alt="" widths={[400, 760, 1140]} width={760} height={428}
            fit="cover" position="center" sizes="(max-width: 800px) 100vw, 760px"
            formats={["webp"]} fallbackFormat="jpg" loading="lazy" />
        )}
        <p class="post-meta">
          <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
          <span aria-hidden="true">·</span>
          <span>{readingMinutes(p.body)} min read</span>
          {p.data.draft && <span class="pill pill-draft">Draft</span>}
        </p>
        <h2><a href={`/blog/${p.id}/`}>{p.data.title}</a></h2>
        <p class="post-desc">{p.data.description}</p>
        {p.data.tags.length > 0 && (
          <ul class="tags" aria-label="Tags">
            {p.data.tags.map((t) => <li><a href={`/blog/tags/${tagSlug(t)}/`}>{t}</a></li>)}
          </ul>
        )}
      </li>
    ))}
  </ol>
)}
